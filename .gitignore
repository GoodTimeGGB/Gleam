# 构建产物
bin/
*.exe
*.test
*.out
tmp/

# 变异脚本 import _harness 留下的字节码缓存（每次跑批都会生成，不该进仓库）
__pycache__/
*.pyc

# 本机 Go 构建缓存（几百 MB，本机专用）
.gocache/

# 发布产物：scripts/package.sh 可重建，不入库
dist/
website/dist/
pack/*.zip

# AI Agent 工具目录（本机专用，不入库）
.workbuddy-ai/
.qoder-cn/
.cursor/
.claude/
.agents/

# 内部文档（仅 README.md 对外展示）
AGENTS.md
