{
  "name": "gleam-desktop",
  "productName": "Gleam",
  "version": "1.1.1",
  "description": "Gleam desktop shell (Electron) - Phase 0 spike",
  "author": "Gleam",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run build:sidecar && npm run build:ts",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "pack:linux": "npm run build && electron-builder --linux dir"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "electron": "41.10.6",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "electron@41.10.6": true,
    "electron-winstaller@5.4.0": true
  }
}
